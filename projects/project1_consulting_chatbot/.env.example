# ============================================================
# AI Consulting Chatbot - Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# ----------------------------------------------------------
# OpenAI Configuration (Required)
# ----------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-org-id-here  # Optional

# ----------------------------------------------------------
# Model Configuration
# ----------------------------------------------------------
# Chat model: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
CHAT_MODEL=gpt-4o-mini
CHAT_MODEL_TEMPERATURE=0.1
CHAT_MODEL_MAX_TOKENS=2048

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small
# Alternative: text-embedding-3-large, text-embedding-ada-002

# ----------------------------------------------------------
# Vector Store Configuration
# ----------------------------------------------------------
# Options: chroma, faiss
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PERSIST_DIR=./chroma_db
VECTOR_STORE_COLLECTION_NAME=housing_faq

# ----------------------------------------------------------
# Retriever Configuration
# ----------------------------------------------------------
# Options: similarity, mmr, similarity_score_threshold
RETRIEVER_SEARCH_TYPE=mmr
RETRIEVER_K=5
RETRIEVER_SCORE_THRESHOLD=0.7
# MMR fetch_k (number of docs to fetch before MMR reranking)
RETRIEVER_FETCH_K=20

# ----------------------------------------------------------
# Text Splitting Configuration
# ----------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ----------------------------------------------------------
# Gradio UI Configuration
# ----------------------------------------------------------
GRADIO_SERVER_PORT=7860
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SHARE=false
GRADIO_THEME=soft
# Auth (optional): leave empty to disable
GRADIO_AUTH_USERNAME=
GRADIO_AUTH_PASSWORD=

# ----------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------
APP_NAME=주택청약 AI 상담 챗봇
APP_DESCRIPTION=주택청약 관련 궁금한 사항을 AI가 안내해 드립니다.
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
DATA_DIR=./data
