# ============================================================
# Company Analysis Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ------------------------------------------------------------
# OpenAI API
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-org-id-here  # Optional

# Models
OPENAI_LLM_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ------------------------------------------------------------
# Neo4j Graph Database
# ------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# For Neo4j AuraDB (cloud):
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-aura-password

# ------------------------------------------------------------
# Anthropic API (optional alternative LLM)
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=7860

# Data directories
DATA_DIR=./data
OUTPUT_DIR=./output
PARSED_DOCS_DIR=./output/parsed
GRAPHS_DIR=./output/graphs
REPORTS_DIR=./output/reports

# ------------------------------------------------------------
# Vector Store Settings
# ------------------------------------------------------------
FAISS_INDEX_PATH=./output/faiss_index
VECTOR_STORE_TOP_K=10
EMBEDDING_BATCH_SIZE=32

# ------------------------------------------------------------
# CLIP Settings
# ------------------------------------------------------------
CLIP_MODEL_NAME=ViT-L/14
CLIP_DEVICE=cpu  # or "cuda" if GPU available

# ------------------------------------------------------------
# Document Parsing Settings
# ------------------------------------------------------------
UNSTRUCTURED_API_KEY=your-unstructured-api-key  # Optional: for cloud API
UNSTRUCTURED_API_URL=https://api.unstructured.io/general/v0/general
USE_UNSTRUCTURED_API=false  # true to use cloud API, false for local

# Tesseract OCR path (Windows only, leave empty on Linux/Mac)
TESSERACT_PATH=

# PDF to Image DPI
PDF_IMAGE_DPI=200

# ------------------------------------------------------------
# Graph RAG Settings
# ------------------------------------------------------------
GRAPH_COMMUNITY_ALGORITHM=leiden  # leiden or louvain
GRAPH_MAX_COMMUNITY_SIZE=10
GRAPH_TRAVERSAL_DEPTH=3
GRAPH_LOCAL_SEARCH_TOP_K=5
GRAPH_GLOBAL_SEARCH_TOP_K=3

# ------------------------------------------------------------
# LLM Settings
# ------------------------------------------------------------
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# Entity extraction
ENTITY_EXTRACTION_MAX_TOKENS=2000
ENTITY_TYPES=Company,Executive,Product,Subsidiary,FinancialMetric,Market,Risk

# ------------------------------------------------------------
# Cache Settings
# ------------------------------------------------------------
ENABLE_CACHE=true
CACHE_DIR=./output/cache
CACHE_TTL_SECONDS=86400  # 24 hours

# ------------------------------------------------------------
# Gradio Settings
# ------------------------------------------------------------
GRADIO_SHARE=false
GRADIO_AUTH=  # Optional: "username:password"
GRADIO_ANALYTICS_ENABLED=false
