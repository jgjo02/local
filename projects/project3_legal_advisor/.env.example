# ============================================================
# Legal Advisor Agent - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.

# ------------------------------------------------------------
# OpenAI Configuration (Required)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=4096

# Embeddings model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------
# Tavily Web Search (Required for web search features)
# ------------------------------------------------------------
TAVILY_API_KEY=tvly-your-tavily-api-key-here
TAVILY_MAX_RESULTS=5

# ------------------------------------------------------------
# LangSmith Tracing (Optional but recommended for debugging)
# ------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your-langsmith-api-key-here
LANGCHAIN_PROJECT=legal-advisor-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------
# Vector Store Configuration
# ------------------------------------------------------------
# Options: chroma, faiss
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./vector_store
CHROMA_COLLECTION_NAME=legal_documents

# ------------------------------------------------------------
# Document Processing
# ------------------------------------------------------------
LEGAL_DOCS_PATH=./data
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ------------------------------------------------------------
# RAG Configuration
# ------------------------------------------------------------
# Number of documents to retrieve
RETRIEVER_K=5
# Relevance score threshold (0.0 - 1.0)
RELEVANCE_THRESHOLD=0.7
# Maximum retry iterations for Self-RAG
MAX_ITERATIONS=3

# ------------------------------------------------------------
# Human-in-the-Loop Configuration
# ------------------------------------------------------------
# Whether to require human approval by default
REQUIRE_HUMAN_APPROVAL=false
# Confidence threshold below which HITL is triggered automatically
HITL_CONFIDENCE_THRESHOLD=0.75

# ------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=7860
APP_TITLE=Legal Advisor Agent (법률 상담 에이전트)
DEBUG=false
LOG_LEVEL=INFO
